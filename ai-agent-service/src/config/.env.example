# ===== LLM Provider 配置 =====
LLM_PROVIDER=deepseek

# deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 应用 =====
LOG_LEVEL=INFO

# ===== Memory =====
MEMORY_SHORT_TERM_TURNS=10
MEMORY_LONG_TERM_DB=data/memory.db

# ===== RAG =====
RAG_EMBEDDING_MODEL=bge-small-zh-v1.5
RAG_TOP_K=5

# ===== Web Search =====
# 提供商：bing（默认，免 key HTML 抓取）/ duckduckgo / bing_api / tavily / serpapi
WEB_SEARCH_PROVIDER=bing
# 可选 API key（bing_api / tavily / serpapi 需要）
# BING_SEARCH_KEY=
# TAVILY_API_KEY=
# SERPAPI_KEY=
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_MAX_RESULTS=5

# ===== DayLoop Agent Integration API（§9）=====
DAYLOOP_API_BASE=http://localhost:3001/api/v1/agent
# 服务间认证 Token（§43，需与 DayLoop 后端 DAYLOOP_SERVICE_TOKEN 一致）
DAYLOOP_SERVICE_TOKEN=DayLoop-Agent-Service-Token-2026
DAYLOOP_API_TIMEOUT=5